# ──── Auth0 ────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sprint-guardian.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ──── Token Vault connection names (enterprise path) ────
JIRA_CONNECTION_NAME=Atlassian
GITHUB_CONNECTION_NAME=github
SLACK_CONNECTION_NAME=slack

# ──── GitHub Direct Integration ────
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo

# ──── Jira Direct Integration ────
JIRA_HOST=your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_DEFAULT_PROJECT=ENG

# ──── Slack Direct Integration ────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=#engineering

# ──── AI Provider (groq or gemini) ────
AI_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key
GEMINI_API_KEY=

# ──── Server ────
PORT=3001
HOST=0.0.0.0

# ──── Scheduler (autonomous agent loops) ────
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 9 * * 1-5
SCHEDULER_WEEKLY_CRON=0 8 * * 1
SCHEDULER_AUDIT_USER_ID=auth0|scheduler
SCHEDULER_ORG_ID=default
SCHEDULER_JIRA_SITE=your-company.atlassian.net
SCHEDULER_JIRA_PROJECT=ENG
SCHEDULER_GITHUB_OWNER=your-org
SCHEDULER_GITHUB_REPO=your-repo
SCHEDULER_SLACK_CHANNEL=#engineering
