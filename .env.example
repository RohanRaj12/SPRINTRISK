# ──── Auth0 ────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sprint-guardian.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ──── Token Vault connection names ────
JIRA_CONNECTION_NAME=Atlassian
GITHUB_CONNECTION_NAME=github
SLACK_CONNECTION_NAME=slack

# ──── Google Gemini ────
GEMINI_API_KEY=

# ──── Server ────
PORT=3001
HOST=0.0.0.0

# ──── Scheduler (automatic sprint audits) ────
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 9 * * 1-5
SCHEDULER_AUDIT_USER_ID=
SCHEDULER_JIRA_SITE=your-company.atlassian.net
SCHEDULER_JIRA_PROJECT=ENG
SCHEDULER_GITHUB_OWNER=your-org
SCHEDULER_GITHUB_REPO=your-repo
SCHEDULER_SLACK_CHANNEL=#engineering
