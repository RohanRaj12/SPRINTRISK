# ════════════════════════════════════════════════
# Sprint Guardian — Environment Configuration
# ════════════════════════════════════════════════
# Copy this to .env and fill in your values.
# Auth0 is REQUIRED. GitHub/Slack/Jira are optional but recommended.

# ──── Auth0 by Okta (REQUIRED — Core Identity Layer) ────
# Auth0 provides JWT auth, PKCE OAuth, M2M credentials, and Token Vault.
# 1. Create tenant at https://auth0.com
# 2. Create an API (identifier = AUTH0_AUDIENCE)
# 3. Create an M2M app authorized for the Management API
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.sprint-guardian.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# ──── GitHub Integration ────
# Generate a PAT: https://github.com/settings/tokens
# Fine-grained PAT scopes needed:
#   - Contents: read
#   - Issues: read+write
#   - Pull requests: read+write
#   - Checks: read
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_DEFAULT_OWNER=your-org
GITHUB_DEFAULT_REPO=your-repo
GITHUB_WEBHOOK_SECRET=          # Optional: for webhook signature verification

# ──── Slack Integration ────
# Create a Slack App: https://api.slack.com/apps
# Bot Token Scopes: chat:write, channels:read, users:read, users:read.email, im:write, reactions:write
# Install to workspace and copy Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxx-xxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
SLACK_DEFAULT_CHANNEL=#engineering
SLACK_SIGNING_SECRET=           # Optional: for event verification
SLACK_APP_ID=                   # Optional

# ──── Jira Integration ────
# Create API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=your-company.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT=ENG

# ──── Token Vault Connection Names (enterprise path) ────
# Used when tokens are managed via Auth0 Token Vault linked identities
JIRA_CONNECTION_NAME=Atlassian
GITHUB_CONNECTION_NAME=github
SLACK_CONNECTION_NAME=slack

# ──── AI Provider ────
# Options: "groq" (default, free tier) or "gemini"
AI_PROVIDER=groq
GROQ_API_KEY=          # Free at https://console.groq.com
GEMINI_API_KEY=        # Only needed if AI_PROVIDER=gemini

# ──── Server ────
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
